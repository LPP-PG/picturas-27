FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core fonts-noto-core fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ./video/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY ./utils/env.py ./utils/env.py
COPY ./video/worker.py ./video/video_media.py ./
COPY ./video/subtitle_worker.py ./video/subtitles.py ./

CMD [ "python", "-u", "subtitle_worker.py" ]
